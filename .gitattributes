# Normalise text files across operating systems.
* text=auto
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Keep notebooks recognised correctly by GitHub Linguist.
*.ipynb linguist-language=Jupyter Notebook

# Binary model files should never be line-normalised.
*.joblib binary
